# MC_DATA_DIR is the directory where the data is stored
# MC_DATA_DIR=

# MC_ACTIVE_DIR is the directory where the live minecraft server is stored
# MC_ACTIVE_DIR=

# MC_BACKUP_DIR is the directory where the backups are stored
# MC_BACKUP_DIR=

# MC_VERSIONS_DIR is the directory where the minecraft server versions are stored
# MC_VERSIONS_DIR=

# MC_EVENTS_DIR is the directory where the event log (one YYYY-MM-DD.jsonl file per UTC day) is written.
# Created if missing. Defaults to MC_DATA_DIR/events
# MC_EVENTS_DIR=

# --- Backup retention (all optional, invalid values fall back to the defaults shown) ---
# World backups (hourly zips in MC_BACKUP_DIR/<level-name>). A backup is kept if any rule claims it; the newest
# backup is never deleted. For the daily..yearly rules, only the newest backup in each calendar period is kept,
# for the N most recent periods that contain a backup. 0 disables a rule.
# MC_BACKUP_KEEP_ALL_HOURS=48
# MC_BACKUP_KEEP_DAILY=7
# MC_BACKUP_KEEP_WEEKLY=4
# MC_BACKUP_KEEP_MONTHLY=6
# MC_BACKUP_KEEP_YEARLY=2

# Update backups (MC_BACKUP_DIR/updates). KEEP_LAST newest are always kept, then thinned tiers
# (one per 3 months, one per 6 months, one per year).
# MC_UPDATE_BACKUP_KEEP_LAST=6
# MC_UPDATE_BACKUP_KEEP_QUARTERLY=4
# MC_UPDATE_BACKUP_KEEP_HALF_YEARLY=2
# MC_UPDATE_BACKUP_KEEP_YEARLY=3

# Number of downloaded server versions kept in MC_VERSIONS_DIR (minimum 1)
# MC_KEEP_DOWNLOADED_VERSIONS=5

# Log what would be deleted instead of deleting (true/false)
# MC_BACKUP_PRUNE_DRY_RUN=false

# Comma separated patterns (fnmatch, matched against the world-relative path and file name) of files ignored when
# checking whether a world changed since the last backup. Empty by default: everything is compared.
# MC_BACKUP_MANIFEST_IGNORE=

# MC_DAILY_RESTART_UTC restarts the server once a day at this UTC time (HH:MM, 24 hour), after a 15 minute warning and a backup.
# Unset to disable. Starting the server after this time does not trigger an immediate restart.
# 10:00 UTC is 4:00 a.m. in Saskatchewan (UTC-6, no daylight saving)
# MC_DAILY_RESTART_UTC=10:00

# MC_STARTUP_COMMANDS_FILE is a text file of commands sent to the server on every start (one per line, $$sleep(N) to wait).
# Created from startup_commands.template.txt on first start. Defaults to startup_commands.txt in the project root.
# MC_STARTUP_COMMANDS_FILE=

# --- Admin alerts (all optional) ---
# CRITICAL log messages (and sustained update failures) show in game as a short "say" message and, if a webhook is
# configured, are POSTed to it as JSON. Nothing is sent to any webhook unless MC_ALERT_WEBHOOK_URL is set.
# MC_ALERT_WEBHOOK_URL=https://example.com/your-webhook

# Minimum level that raises an alert: ERROR or CRITICAL
# MC_ALERT_MIN_LEVEL=CRITICAL

# Show alerts in game (true/false)
# MC_ALERT_IN_GAME=true

# Identical alerts (same logger and message) within this many minutes are suppressed and counted (0 disables)
# MC_ALERT_COOLDOWN_MINUTES=30

# Consecutive failures to find or download a server update before a CRITICAL is logged
# MC_ALERT_SCRAPE_FAILURE_THRESHOLD=6
